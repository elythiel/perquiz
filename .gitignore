# dependencies
node_modules
.yarn/*
!.yarn/patches
!.yarn/releases
.pnp.*

# nuxt
.nuxt
.output
.data
dist
.nitro
.cache

# typescript (the tsconfig.test.json project writes its cache at the root)
*.tsbuildinfo

# environment
.env
.env.*
!.env.example

# persistent state (SQLite + photos) — never committed, but the ./data/ and
# ./data/photos/ directories must exist on a fresh clone.
data/*
!data/.gitkeep
!data/photos/
data/photos/*
!data/photos/.gitkeep

# system
.DS_Store
*.log
