# --- Session applicative -------------------------------------------------
# Secret de chiffrement du cookie de session (>= 32 caractères).
# Générer avec : openssl rand -base64 32
NUXT_SESSION_PASSWORD=

# --- URL publique --------------------------------------------------------
# Base absolue de l'app, utilisée pour construire les URL de redirection OIDC.
NUXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Identité : Zitadel (OIDC, code + PKCE) ------------------------------
# Issuer de l'instance Zitadel, p. ex. https://auth.exemple.tld
NUXT_ZITADEL_ISSUER=
# Client ID de l'application « Web / PKCE » créée dans le projet Perquiz.
NUXT_ZITADEL_CLIENT_ID=
# À renseigner uniquement si le client est déclaré confidentiel (sinon laisser vide).
NUXT_ZITADEL_CLIENT_SECRET=

# --- Stockage persistant -------------------------------------------------
# Répertoire contenant app.db et photos/ — un seul volume à sauvegarder.
NUXT_DATA_DIR=./data
