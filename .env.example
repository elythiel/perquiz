# --- Application session ---------------------------------------------------
# Encryption secret for the session cookie (>= 32 characters).
# Generate one with: openssl rand -base64 32
NUXT_SESSION_PASSWORD=

# --- Public URL ------------------------------------------------------------
# The app's absolute base, used to build the OIDC redirect URLs.
NUXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Identity: OIDC provider (code + PKCE) ---------------------------------
# Perquiz is the client of any OIDC provider that can assert roles in the
# token. The defaults below describe Zitadel — the reference configuration,
# and the only one this has been tested against. Endpoints are discovered from
# <issuer>/.well-known/openid-configuration; none is hard-coded.

# The provider's issuer URL, e.g. https://auth.example.tld — HTTPS only, the
# OIDC client refuses a plaintext issuer. A trailing slash is harmless.
NUXT_OIDC_ISSUER=
# Client ID of the "Web / PKCE" application declared at the provider.
NUXT_OIDC_CLIENT_ID=
# Only needed if the client is declared confidential (leave empty for PKCE).
NUXT_OIDC_CLIENT_SECRET=

# Written to identities.provider, so an instance can tell its logins apart if
# it ever switches provider. Any short slug; no behaviour depends on it.
NUXT_OIDC_PROVIDER_ID=zitadel

# The claim holding the user's roles. Dots walk down the token, so nested
# claims work: realm_access.roles (Keycloak). Three shapes are understood —
# an array of strings, an object whose keys are the roles (Zitadel), and a
# space-separated string.
#   Zitadel            urn:zitadel:iam:org:project:roles
#   Keycloak           realm_access.roles
#   Authentik/Authelia groups
NUXT_OIDC_ROLES_CLAIM=urn:zitadel:iam:org:project:roles

# The two role names Perquiz looks for in that claim. A user holding neither
# is refused with the "not on the guest list" screen; no account is created.
NUXT_OIDC_ROLE_PLAYER=player
NUXT_OIDC_ROLE_ADMIN=admin

# Scopes requested at login, space-separated. Some providers only emit roles
# or groups when an extra scope is asked for (Keycloak: "roles").
NUXT_OIDC_SCOPES=openid profile email

# --- Persistent storage ----------------------------------------------------
# Directory holding app.db and photos/ — a single volume to back up.
NUXT_DATA_DIR=./data
