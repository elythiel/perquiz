# --- Application session ---------------------------------------------------
# Encryption secret for the session cookie (>= 32 characters).
# Generate one with: openssl rand -base64 32
NUXT_SESSION_PASSWORD=

# --- Public URL ------------------------------------------------------------
# The app's absolute base, used to build the OIDC redirect URLs.
NUXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Identity: Zitadel (OIDC, code + PKCE) ---------------------------------
# The Zitadel instance issuer, e.g. https://auth.example.tld
NUXT_ZITADEL_ISSUER=
# Client ID of the "Web / PKCE" application created in the Perquiz project.
NUXT_ZITADEL_CLIENT_ID=
# Only needed if the client is declared confidential (leave empty otherwise).
NUXT_ZITADEL_CLIENT_SECRET=

# --- Persistent storage ----------------------------------------------------
# Directory holding app.db and photos/ — a single volume to back up.
NUXT_DATA_DIR=./data
