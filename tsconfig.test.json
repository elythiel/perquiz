{
  // Everything that lives outside Nuxt's reach — its generated tsconfigs only
  // cover app/, server/ and shared/. Without this project, `yarn typecheck`
  // would not read a single line of tests/ or scripts/.
  "extends": "./.nuxt/tsconfig.node.json",
  "compilerOptions": {
    // The tests read main.css and the locale file off disk, and the seed
    // writes images: all of it needs node:fs, which the Nuxt base config hides
    // with `"types": []`.
    "types": ["node"],
    // `yarn seed` is a plain node process: its imports carry the `.ts`
    // extension node's ESM resolver requires.
    "allowImportingTsExtensions": true,
    // The endpoint tests load `server/` code, which reaches for `#shared` the
    // way Nitro resolves it.
    "paths": {
      "#shared/*": ["./shared/*"]
    }
  },
  "include": [
    "tests/**/*",
    "scripts/**/*",
    "vitest.config.ts",
    "drizzle.config.ts",
    // Nitro's auto-imports, declared as globals. The endpoint tests import
    // handlers and utils that call `useDatabase()` and friends without ever
    // importing them; without this the whole server surface is untypeable from
    // here. Generated by `nuxt prepare`, like every other project's types.
    ".nuxt/types/nitro-imports.d.ts"
  ]
}
